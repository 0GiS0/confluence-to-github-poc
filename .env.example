# Copy to ~/.config/confluence-poc/.env (recommended) or export these as environment variables.
# Never commit real values.
CONFLUENCE_URL=https://your-site.atlassian.net
CONFLUENCE_USER=you@example.com
CONFLUENCE_API_TOKEN=your-api-token
CONFLUENCE_SPACE_KEY=POC
# Optional: title of the root page whose descendants are exported.
# Defaults to "Engineering Handbook", the synthetic seeded tree.
CONFLUENCE_ROOT_PAGE_TITLE=Engineering Handbook
